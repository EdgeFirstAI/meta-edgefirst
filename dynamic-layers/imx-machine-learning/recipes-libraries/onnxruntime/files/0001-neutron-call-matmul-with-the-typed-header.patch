--- a/onnxruntime/core/providers/neutron/ops/matmul_nbits.cc	2026-10-20 06:21:10.634075202 +0000
+++ b/onnxruntime/core/providers/neutron/ops/matmul_nbits.cc	2026-10-20 06:21:10.670076872 +0000
@@ -781,7 +781,7 @@
 
 #if defined(USE_NBITS_KERNEL) || defined(USE_8BITS_KERNEL)
     NeutronError ret = ENONE;
-    ret = matmul((const void *)m_header, 16 * sizeof(uint32_t), (const void *)a_neutron, a_size, 
+    ret = matmul((const NeutronMatmulHeader *)m_header, (const void *)a_neutron, a_size, 
 		 (const void *)y_neutron, y_size, m_handle);
     if (ret != ENONE) {
       return ORT_MAKE_STATUS(ONNXRUNTIME, FAIL, "NeutronEP:MatMulNBits falied to call kernel");
diff -ru a/onnxruntime/core/providers/neutron/ops/qgemm.cc b/onnxruntime/core/providers/neutron/ops/qgemm.cc
--- a/onnxruntime/core/providers/neutron/ops/qgemm.cc	2026-10-20 06:21:10.642075573 +0000
+++ b/onnxruntime/core/providers/neutron/ops/qgemm.cc	2026-10-20 06:21:10.671076919 +0000
@@ -388,7 +388,7 @@
     m_header[15] = (uint8_t *)m_decode_input - (uint8_t *)m_header;
 
     NeutronError ret = ENONE;
-    ret = matmul((const void *)m_header, 16*sizeof(uint32_t), (const void*)a_neutron,
+    ret = matmul((const NeutronMatmulHeader *)m_header, (const void*)a_neutron,
 		 a_size, (const void*)y_neutron, y_size, m_handle);
     if (ret != ENONE){
       return ORT_MAKE_STATUS(ONNXRUNTIME, FAIL, "matmul() error");
diff -ru a/onnxruntime/core/providers/neutron/ops/qlinear_matmul.cc b/onnxruntime/core/providers/neutron/ops/qlinear_matmul.cc
