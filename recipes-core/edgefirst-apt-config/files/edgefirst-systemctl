#!/bin/sh
# Placed first on dpkg's PATH by 50edgefirst, so only the maintainer scripts of
# packages that apt installs run through it. Package scripts generated by Yocto
# call systemctl enable and restart for every unit file in the package. On a
# running system that fails for template units and for units that refuse manual
# start, which are not meant to be enabled or started by name, and a failed
# script leaves the package and everything depending on it unconfigured.
# Those failures are reported and ignored; every other result is passed on.
REAL=/usr/bin/systemctl
[ -x "$REAL" ] || REAL=/bin/systemctl

verb=
for arg in "$@"; do
    case "$arg" in -*) ;; *) verb="$arg"; break ;; esac
done

err="$(mktemp)" || exec "$REAL" "$@"
trap 'rm -f "$err"' EXIT
"$REAL" "$@" 2>"$err"
rc=$?
cat "$err" >&2
[ "$rc" -eq 0 ] && exit 0

case "$verb" in
    enable|disable|reenable|preset)
        echo "systemctl $verb failed (ignored by edgefirst-apt-config)" >&2
        exit 0 ;;
    start|restart|try-restart|reload-or-restart)
        if grep -q -e 'may be requested by dependency only' -e 'is missing the instance name' "$err"; then
            echo "systemctl $verb refused for a unit that is not started by name (ignored by edgefirst-apt-config)" >&2
            exit 0
        fi ;;
esac
exit "$rc"
